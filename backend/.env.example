# ---------------------------------------------------------------------------
# SmartLearn AI backend configuration
# Copy this file to backend/.env and adjust values.
# ---------------------------------------------------------------------------

ENV=development

# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://smartlearn:smartlearn@localhost:5432/smartlearn
DATABASE_URL=sqlite:///./smartlearn.db

# Use a long random string in production.
JWT_SECRET=change-me-in-production-smartlearn-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# LLM (optional). Leave OPENAI_API_KEY empty to use the deterministic engine.
# LLM_PROVIDER: openai | compatible | ollama | langchain | none
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Retrieval augmented generation
# ChromaDB requires USE_CHROMA=true, the optional requirements-ai.txt packages
# and a valid embedding/LLM key. Otherwise TF-IDF retrieval is used.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
USE_CHROMA=false
CHROMA_DIR=./chroma_store

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
COURSE_URL_VALIDATION=true
URL_VALIDATION_TIMEOUT=6
SEED_DEMO_DATA=true
